{
  "crons": [
    {
      "path": "/api/daily-digest",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/snapshot-portfolio?currencies=INR&tz=Asia/Kolkata",
      "schedule": "5 10 * * 1-5"
    },
    {
      "path": "/api/snapshot-portfolio?currencies=USD&tz=America/New_York",
      "schedule": "5 21 * * 1-5"
    },
    {
      "path": "/api/snapshot-portfolio?currencies=USD&tz=America/New_York",
      "schedule": "5 20 * * 1-5"
    },
    {
      "path": "/api/snapshot-portfolio?currencies=AUD&tz=Australia/Sydney",
      "schedule": "5 5 * * 1-5"
    },
    {
      "path": "/api/snapshot-portfolio?currencies=AUD&tz=Australia/Sydney",
      "schedule": "5 6 * * 1-5"
    },
    {
      "path": "/api/snapshot-portfolio?currencies=EUR,GBP,SGD,AED,CAD&tz=UTC",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/portfolio-sync-reminder",
      "schedule": "30 8 * * 5"
    },
    {
      "path": "/api/portfolio-prices?action=markets&persist=1",
      "schedule": "30 22 * * 1-5"
    }
  ],
  "functions": {
    "api/agent.ts": {
      "maxDuration": 60
    },
    "api/snapshot-portfolio.ts": {
      "maxDuration": 60
    }
  }
}
